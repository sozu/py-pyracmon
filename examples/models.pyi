from pyracmon.model_graph import GraphEntityMixin
from pyracmon.stub import ModelTransform
from pyracmon.testing import TestingMixin
from pyracmon.dialect.postgresql import PostgreSQLMixin

class blog(PostgreSQLMixin, TestingMixin, CRUDMixin, GraphEntityMixin, ModelTransform, Model):
    id: int = ...
    title: str = ...

class blog_category(PostgreSQLMixin, TestingMixin, CRUDMixin, GraphEntityMixin, ModelTransform, Model):
    id: int = ...
    blog_id: int = ...
    name: str = ...

class image(PostgreSQLMixin, TestingMixin, CRUDMixin, GraphEntityMixin, ModelTransform, Model):
    post_id: int = ...
    url: str = ...

class post(PostgreSQLMixin, TestingMixin, CRUDMixin, GraphEntityMixin, ModelTransform, Model):
    id: int = ...
    blog_id: int = ...
    title: str = ...
    content: str = ...

class post_comment(PostgreSQLMixin, TestingMixin, CRUDMixin, GraphEntityMixin, ModelTransform, Model):
    id: int = ...
    post_id: int = ...
    likes: int = ...
    content: str = ...
